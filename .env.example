# Configuração local do Nexo's
# Preencha os valores reais antes de rodar o projeto

# MongoDB
MONGO_URL=mongodb://localhost:27017
DB_NAME=nexos_school

# URL pública do app (usada pelo frontend se precisar)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# CORS
CORS_ORIGINS=*

# Chave Emergent LLM (Universal Key) — obtenha em https://help.emergent.sh/universal-key
EMERGENT_LLM_KEY=sk-emergent-COLE_AQUI_SUA_CHAVE
GEMINI_MODEL=gemini-2.5-flash
