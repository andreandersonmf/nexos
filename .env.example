# Configuração local do Nexo's
# Preencha os valores reais antes de rodar o projeto

# MongoDB
MONGO_URL=mongodb://localhost:27017
DB_NAME=nexos_school

# URL pública do app (usada pelo frontend se precisar)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# CORS
CORS_ORIGINS=*

# Google Gemini API (crie uma chave no Google AI Studio)
GEMINI_API_KEY=COLE_AQUI_SUA_CHAVE_DO_GOOGLE
GEMINI_MODEL=gemini-2.5-flash
